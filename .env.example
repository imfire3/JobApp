# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Required for local-auth (server writes bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (platform key — shared for all users, never asked in the UI)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# France Travail Offres d'emploi v2 (Sources → Run now)
# Register an app at https://francetravail.io and subscribe to « Offres d'emploi v2 »
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
# Optional (default: api_offresdemploiv2 o2dsoffre)
# FRANCE_TRAVAIL_SCOPE=api_offresdemploiv2 o2dsoffre
# Aliases also accepted: FT_CLIENT_ID / FT_CLIENT_SECRET / FT_SCOPE

# Job sync legacy (tracked searches via Apify mock/actors — not Sources UI)
JOB_SYNC_MODE=mock
JOB_SYNC_SECRET=replace-with-long-random-secret
APIFY_TOKEN=
APIFY_WTTJ_ACTOR_ID=
APIFY_LINKEDIN_ACTOR_ID=

# Legacy cron secret (still supported by /api/sync/daily)
CRON_SECRET=replace-with-long-random-secret

# Demo request emails (landing page → FormSubmit → Gmail, free, no API key)
DEMO_NOTIFY_EMAIL=vincentgiacalonepro@gmail.com

# Local self-signup (open on localhost by default; always closed on Vercel)
# ALLOW_SELF_SIGNUP=true
# ALLOW_SELF_SIGNUP=false
