# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Needed for cron sync across all users
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# Job sync (external scraper via Apify)
JOB_SYNC_MODE=mock
JOB_SYNC_SECRET=replace-with-long-random-secret
APIFY_TOKEN=
APIFY_WTTJ_ACTOR_ID=
APIFY_LINKEDIN_ACTOR_ID=

# Legacy cron secret (still supported by /api/sync/daily)
CRON_SECRET=replace-with-long-random-secret
